{
  "name": "tutela-workspace",
  "private": true,
  "description": "The JavaScript SDKs of Tutela: @f8fvwgzc/tutela-js and @f8fvwgzc/tutela-react. `make js` runs every check.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome ci --error-on-warnings .",
    "test": "pnpm -r run test",
    "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
