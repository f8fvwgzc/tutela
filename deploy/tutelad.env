# Production settings for tutelad. Compose reads this file, and the Helm chart
# must set the same values (Phase B). Test values only: never put a real
# password or key here. Secrets go in through the environment or a secret store.

# Panics print a backtrace. anyhow errors do not capture one, because capturing
# one on every error is costly under a high error rate.
RUST_BACKTRACE=1
RUST_LIB_BACKTRACE=0

# JSON logs on stdout. Logs never hold tokens or personal data.
TUTELA_LOG=info

# The API port: every request needs a token.
TUTELA_LISTEN=0.0.0.0:8080
# Health, readiness and metrics. Keep this port out of the public load balancer.
TUTELA_OPS_LISTEN=0.0.0.0:9090

# Readiness fails this long before the listeners stop, so a load balancer can
# move away. Running requests then get the timeout to finish.
TUTELA_SHUTDOWN_DRAIN_SECS=5
TUTELA_SHUTDOWN_TIMEOUT_SECS=30

# How often expired role assignments are removed and the revision bumped.
TUTELA_EXPIRY_SWEEP_SECS=30

# How often a replica checks a tenant's revision while answering. This is the
# delay of a revocation in normal running. 0 checks on every request.
TUTELA_REVISION_CHECK_MS=1000
# How long a replica that cannot reach the database may still answer from what
# it has. Past this it answers 503, never a stale allow. Writes fail sooner.
TUTELA_MAX_AGE_READ_SECS=60
TUTELA_MAX_AGE_WRITE_SECS=10
# The most steps one impact report takes. A report that reaches it says it is
# not complete, and never reads as "no impact" (ADR-0027).
TUTELA_IMPACT_MAX_WORK=2000000

# The JWKS of tutelad's own issuer may be cached this long. A key rotation
# publishes the next key twice this long before it signs (docs/DECISIONS.md
# ADR-0030).
TUTELA_JWKS_CACHE_SECS=300
# How often a replica reads the signing keys again, so a rotation or a denied
# key reaches it.
TUTELA_KEY_REFRESH_SECS=10
# The version of TUTELA_KEY_PEPPER. TUTELA_ISSUER, TUTELA_MASTER_KEY and
# TUTELA_KEY_PEPPER are required and are not in this file: they come from the
# environment or a secret store. Without them tutelad does not start.
TUTELA_KEY_PEPPER_VERSION=1

# The life of an access token from token exchange (60 to 600 s), and of a
# delegated agent token (60 to 120 s). Neither outlives the token it came from.
TUTELA_TOKEN_TTL_SECS=300
TUTELA_DELEGATED_TTL_SECS=90
# The acr values your IdP gives after step-up MFA, comma-separated. Unset, no
# admin token (aud=tutela-admin) is issued. Example: TUTELA_ADMIN_ACR=mfa

# The Tutela Console (ADR-0050), served on the API port under /console/.
# Off while TUTELA_CONSOLE_DIR is unset. The directory holds the built
# Console (console/dist; the OCI image copies it to /srv/tutela/console). It
# is read once at start. TUTELA_CONSOLE_ISSUER is the realm people sign in at
# (an external issuer of the trust file, exactly as written there), and
# TUTELA_CONSOLE_CLIENT_ID the Console's public client there (authorization
# code with PKCE, redirect URI https://<this host>/console/callback). The
# Console asks for the first value of TUTELA_ADMIN_ACR at sign-in, so that
# must be set too.
# TUTELA_CONSOLE_DIR=/srv/tutela/console
# TUTELA_CONSOLE_ISSUER=https://kc.example.com/realms/acme
# TUTELA_CONSOLE_CLIENT_ID=tutela-console

# CORS (ADR-0054), off unless set: the exact origins (scheme://host[:port],
# https; http only on loopback in dev mode) whose pages may call the HTTP
# API with @f8fvwgzc/tutela-js, comma-separated. Never `*`; tutelad never
# allows credentials (the client sends its token in Authorization). The
# Console is same-origin and needs none.
# TUTELA_CORS_ORIGINS=https://crm.example.com,https://admin.example.com

# Events (ADR-0035, ADR-0036). How often this replica delivers events to
# webhooks; 0 turns delivery off here. Events and ended deliveries are kept
# this long (at least two days: retries last 24 hours).
TUTELA_WEBHOOK_POLL_MS=1000
TUTELA_EVENT_RETENTION_SECS=604800
# GET /v1/events (ADR-0037): how often a tenant's feed reads the outbox,
# the most streams per replica, the longest one lasts, and how far behind a
# stream may fall before it gets `reset`.
TUTELA_EVENTS_POLL_MS=500
TUTELA_SSE_MAX_STREAMS=1000
TUTELA_SSE_MAX_SECS=900
TUTELA_SSE_BUFFER=256
# Signed bundles (ADR-0038): the longest one lasts, 1 to 3600 s. A bundle
# ends sooner at the first assignment in it that expires.
TUTELA_BUNDLE_TTL_SECS=300
# A soft-deleted tenant or org keeps its data this long before the purge
# (ADR-0041): 30 days. The audit chain is never purged.
TUTELA_PURGE_GRACE_SECS=2592000
# Every audit chain is walked this often and a broken link reported as an
# error log and tutelad_audit_chains_broken (ADR-0034): one hour.
TUTELA_AUDIT_VERIFY_SECS=3600
# Forwarding of audit records to attache's evidence ledger (ADR-0039), off
# unless TUTELA_LEDGER_URL is set. Then TUTELA_LEDGER_TOKEN (attache's att_
# token) comes from the secret store, never from this file. The producer key
# is sealed in the database (ADR-0045) and made at the first start; a
# deployment that set TUTELA_AUDIT_KEY before keeps it for one start, which
# imports it, and then removes it. Rotate it with `tutela keys rotate --audit`.
# TUTELA_LEDGER_URL=https://embassy.example/api/v1/ledger/append
